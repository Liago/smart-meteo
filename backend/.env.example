PORT=3000
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS - URL del frontend Vercel (obbligatorio in produzione)
FRONTEND_URL=https://your-project.vercel.app

# Weather API Keys
# NB: Open-Meteo non richiede chiave. Meteomatics non è integrata: era nel piano
# iniziale ma è stata sostituita da Open-Meteo, quindi non serve alcuna credenziale.
TOMORROW_API_KEY=your_tomorrow_io_key
OPENWEATHER_API_KEY=your_owm_key
WEATHERAPI_KEY=your_weatherapi_key
ACCUWEATHER_API_KEY=your_accuweather_key
METEOSTAT_KEY=your_rapidapi_meteostat_key
WORLDWEATHER_KEY=your_wwo_key
# Weatherstack è disabilitato (peso 0): il piano free non supporta HTTPS.
WEATHERSTACK_KEY=

# Apple WeatherKit (REST, autenticazione JWT) - vedi docs/WEATHERKIT_SETUP_GUIDE.md
APPLE_TEAM_ID=your_apple_team_id
APPLE_SERVICE_ID=your_weatherkit_service_id
APPLE_KEY_ID=your_weatherkit_key_id
APPLE_PRIVATE_KEY=your_weatherkit_private_key_pem

# Push notifications APNs
APNS_TEAM_ID=your_apple_team_id
APNS_KEY_ID=your_apns_key_id
APNS_PRIVATE_KEY=your_apns_private_key_pem
APNS_BUNDLE_ID=com.yourcompany.smartmeteo
# true = gateway di produzione; senza questa variabile si ricade su NODE_ENV
APNS_PRODUCTION=false

# Protegge POST /api/alerts/poll, chiamato dalla scheduled function di Netlify.
# Senza questa variabile l'endpoint risponde 503 invece di restare aperto.
CRON_SECRET=your_cron_secret

# Modelli Open-Meteo da interrogare come fonti indipendenti (opzionale).
# Vuoto = tutti e cinque (icon_d2, icon_eu, ecmwf_ifs025, meteofrance_seamless,
# gfs_seamless). `off` = torna alla singola fonte best_match. Oppure una lista
# separata da virgole per ridurre le chiamate senza un deploy.
# OPENMETEO_MODELS=icon_d2,ecmwf_ifs025
